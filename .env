# Backend API base URL (no trailing slash).
# Override locally with an untracked .env.local — do not edit this file to
# point at a dev server, it is committed and affects everyone.
#   .env.local  ->  
# VITE_API_BASE_URL=http://velexp.com:8000
# VITE_API_BASE_URL=https://velexp.com
VITE_API_BASE_URL=https://uat.velexp.com

# crypto-js key for the MIS Tally password field.
# Client-side symmetric encryption with a bundled key: obfuscation, not
# security. Tracked for removal — do not add new consumers.
VITE_SECRET_KEY=Velexp.admin

# Selects the auth backend inside the legacy Redux sagas (fake | jwt | firebase).
# Those sagas are unreachable dead code and are removed in Phase 2, along with
# this variable.
VITE_APP_DEFAULTAUTH=fake

# Divisor for volumetric weight = (L x B x H in cm) / this value. Used wherever
# volumetric weight is auto-calculated from dimensions (e.g. AWB Admin Lookup's
# Edit Booking form) rather than typed in directly.
VITE_VOLUMETRIC_WEIGHT_DIVISOR=5000

# Removed — read by nothing in src/ (verified by grep):
#   VITE_APP_APIKEY / AUTHDOMAIN / DATABASEURL / PROJECTID /
#   STORAGEBUCKET / MESSAGINGSENDERID / APPID / MEASUREMENTID
#     -> Firebase config; the firebase dependency is being dropped.
#   GENERATE_SOURCEMAP / INLINE_RUNTIME_CHUNK / NODE_OPTIONS
#     -> Create React App settings. Vite ignores them entirely, and Vite does
#        not apply .env values to the Node process, so NODE_OPTIONS never
#        took effect either.